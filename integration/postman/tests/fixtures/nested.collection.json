{
  "info": {
    "name": "Nested folders fixture",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('status ok', function () {",
          "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Auth",
          "item": [
            {
              "name": "Login",
              "request": {
                "method": "POST",
                "url": {
                  "raw": "{{baseUrl}}/auth/login",
                  "host": ["{{baseUrl}}"],
                  "path": ["auth", "login"]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\"username\": \"{{username}}\", \"password\": \"{{password}}\"}",
                  "options": {"raw": {"language": "json"}}
                }
              }
            },
            {
              "name": "Logout",
              "request": {
                "method": "POST",
                "url": {
                  "raw": "{{baseUrl}}/auth/logout",
                  "host": ["{{baseUrl}}"],
                  "path": ["auth", "logout"]
                }
              }
            }
          ]
        },
        {
          "name": "Profile",
          "item": [
            {
              "name": "Get Profile",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/users/me",
                  "host": ["{{baseUrl}}"],
                  "path": ["users", "me"]
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    }
  ]
}
