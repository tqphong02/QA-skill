# Copy this file to .env and keep the file local-only
PLANE_EMAIL=
PLANE_PASSWORD=
PLANE_BASE_URL=https://projects.metasolutions.ai
PLANE_WORKSPACE_SLUG=mds-team
PLANE_API_KEY=
# Optional path to a user-created browser storage state; never commit it
PLANE_BROWSER_STATE_PATH=auth.json
# Optional shared local config root used by published GLM/Gemini/Codex copies
PLANE_LOCAL_CONFIG_DIR=
# Optional qa-run root containing node_modules/playwright
PLANE_QA_RUN_ROOT=
