{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SHEET_WORKER_RESULT_SCHEMA.json",
  "title": "Evidence-backed Sheet worker results",
  "type": "object",
  "required": ["results"],
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "worker_id": {
      "type": ["integer", "string"]
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["row_number", "result", "priority"],
        "additionalProperties": false,
        "properties": {
          "row_number": {
            "type": "integer",
            "minimum": 1
          },
          "testcase_id": {
            "type": "string"
          },
          "result": {
            "enum": ["Pass", "Fail", "N/A", "Untest"]
          },
          "priority": {
            "enum": ["Critical", "High", "Medium", "Low"]
          },
          "note": {
            "type": "string"
          },
          "tester": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "evidence": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "result": {
                  "enum": ["Pass", "Fail"]
                }
              },
              "required": ["result"]
            },
            "then": {
              "required": ["evidence"]
            }
          },
          {
            "if": {
              "properties": {
                "result": {
                  "enum": ["Fail", "N/A", "Untest"]
                }
              },
              "required": ["result"]
            },
            "then": {
              "required": ["note"],
              "properties": {
                "note": {
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
