{
  "_comment": "Canonical column schema for the team's standard testcase template (assets/Template.xlsx). AI reads this file directly — no need to scan the Excel or Sheet header row. Update here if the template ever changes.",

  "sheet_name": "Test cases_App",
  "header_row": 9,

  "column_mapping": {
    "scenario_id":   1,
    "scenario_name": 2,
    "testcase_id":   3,
    "description":   4,
    "precondition":  5,
    "procedure":     6,
    "expected":      7,
    "result":        8,
    "priority":      9,
    "date":          10,
    "tester":        11,
    "note":          12
  },

  "column_letters": {
    "scenario_id":   "B",
    "scenario_name": "C",
    "testcase_id":   "D",
    "description":   "E",
    "precondition":  "F",
    "procedure":     "G",
    "expected":      "H",
    "result":        "I",
    "priority":      "J",
    "date":          "K",
    "tester":        "L",
    "note":          "M"
  },

  "read_only_columns": ["scenario_id", "scenario_name", "testcase_id", "description", "precondition", "procedure", "expected"],
  "write_columns":     ["result", "priority", "date", "tester", "note"],

  "section_markers": {
    "ui":         "1.1. USER INTERFACE",
    "functional": "1.2. FUNCTION"
  },

  "testcase_id_patterns": {
    "ui":         "[{CODE}-UI-{NN}]",
    "functional": "[{CODE}-{NN}]"
  },

  "dropdown_values": {
    "result":   ["Pass", "Fail", "N/A", "Untest"],
    "priority": ["Critical", "High", "Medium", "Low"]
  },

  "note_required_when_result": ["Fail", "Untest", "N/A"],

  "workflow_composition": {
    "name": "SHEET_EXECUTION_PLUS",
    "required_layers": [
      "Sheet Testcase Execution",
      "Sanity",
      "Impacted Regression",
      "Scoped Business Discovery",
      "Exploratory",
      "Ad-hoc",
      "UI/UX"
    ],
    "conditional_layer": "Original Retest only for rows linked to a Plane ticket or previous failure",
    "plane_mutation_rule": "Do not comment or change Plane state without an exact ticket"
  },

  "cover_sheet": {
    "sheet_name": "Cover",
    "cells": {
      "project_name":    "B3",
      "project_code":    "C3",
      "device":          "D3",
      "priority_total":  "E3",
      "description":     "B5",
      "version":         "D5",
      "test_date":       "E5",
      "objective":       "B7",
      "author":          "D7",
      "reviewer":        "E7"
    }
  },

  "report_sheet": {
    "sheet_name": "Report",
    "aggregate_range": "Test cases_App!rows 9-1723",
    "counts": ["Pass", "Fail", "N/A", "Untested"]
  }
}
