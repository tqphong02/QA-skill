# Đặt file .env này trong THƯ MỤC DỰ ÁN bạn test (không phải trong skill).
# Chạy script từ thư mục đó: node ~/.claude/skills/qa-run/scripts/login.mjs
QA_BASE_URL=https://your-app.example.com
QA_EMAIL=you@example.com
QA_PASSWORD=

# (tuỳ chọn) sweep.mjs: danh sách route, để trống sẽ tự dò link nav
QA_ROUTES=/dashboard,/settings
# (tuỳ chọn) api-health.mjs: hoặc dùng file endpoints.txt cùng thư mục
QA_ENDPOINTS=/api/health,/api/me

# (tuỳ chọn) cho test export Google Sheets
QA_GCP_SA_JSON=/path/to/service-account.json
QA_SHEET_ID=
