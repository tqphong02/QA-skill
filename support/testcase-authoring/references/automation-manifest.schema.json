{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-skill.local/schemas/testcase-automation-manifest-v1.json",
  "title": "Lossless testcase to POM automation manifest",
  "type": "object",
  "required": ["schema_version", "source", "rbac", "testcases"],
  "properties": {
    "schema_version": { "const": 1 },
    "source": {
      "type": "object",
      "required": ["project_code", "markdown_file", "markdown_sha256", "testcase_count"],
      "properties": {
        "project_code": { "type": "string" },
        "source_document": { "type": ["string", "null"] },
        "markdown_file": { "type": "string", "minLength": 1 },
        "markdown_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "testcase_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "rbac": { "type": ["object", "null"] },
    "requirement_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "coverage_item_id", "requirement", "description", "source_ref",
          "expected_result", "minimum_cases", "required_case_types",
          "required_techniques", "testcase_ids", "status"
        ],
        "properties": {
          "coverage_item_id": { "type": "string", "pattern": "^COV[-_][A-Za-z0-9]+(?:[-_][A-Za-z0-9]+)*$" },
          "requirement": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "source_ref": { "type": "string", "minLength": 1 },
          "expected_result": { "type": "string", "minLength": 1 },
          "minimum_cases": { "type": "integer", "minimum": 1 },
          "required_case_types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "required_techniques": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "testcase_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "status": { "const": "COVERED" }
        },
        "additionalProperties": false
      }
    },
    "testcases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "testcase_id", "testcase_id_display", "section_kind", "group",
          "scenario_id", "scenario_name", "type", "requirement", "priority",
          "description", "execution"
        ],
        "properties": {
          "testcase_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]*(?:[-_][A-Za-z0-9]+)+$"
          },
          "testcase_id_display": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]*(?:[-_][A-Za-z0-9]+)+$"
          },
          "case_ref": { "type": ["string", "null"] },
          "section_kind": { "type": "string", "minLength": 1 },
          "group": { "type": "string", "minLength": 1 },
          "scenario_id": { "type": "string", "minLength": 1 },
          "scenario_name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "bb_technique": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            ]
          },
          "requirement": { "type": "string", "minLength": 1 },
          "priority": { "type": "string", "minLength": 1 },
          "automation_tags": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^@[a-z][a-z0-9-]*$" }
          },
          "lifecycle_hooks": {
            "type": ["object", "null"],
            "minProperties": 1,
            "properties": {
              "before_test": { "$ref": "#/$defs/implementationHook" },
              "after_test": { "$ref": "#/$defs/implementationHook" }
            },
            "additionalProperties": false
          },
          "description": { "type": "string", "minLength": 1 },
          "coverage_item_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^COV[-_][A-Za-z0-9]+(?:[-_][A-Za-z0-9]+)*$" }
          },
          "execution": { "type": ["object", "null"] },
          "api": { "type": ["object", "null"] },
          "automation_selection": {
            "type": ["object", "null"],
            "required": [
              "decision", "execution_frequency", "manual_cost",
              "business_risk", "maintenance_cost", "rationale"
            ],
            "properties": {
              "decision": { "enum": ["AUTOMATE", "DEFER", "REJECT"] },
              "execution_frequency": { "type": "integer", "minimum": 1, "maximum": 5 },
              "manual_cost": { "type": "integer", "minimum": 1, "maximum": 5 },
              "business_risk": { "type": "integer", "minimum": 1, "maximum": 5 },
              "maintenance_cost": { "type": "integer", "minimum": 1, "maximum": 5 },
              "recommended_layer": { "enum": ["UNIT", "COMPONENT", "API", "UI"] },
              "layer_rationale": { "type": "string", "minLength": 1 },
              "extended_roi": {
                "type": "object",
                "required": [
                  "build_cost", "infrastructure_cost", "feedback_speed_value",
                  "defect_prevention_value", "coverage_value", "reliability_confidence"
                ],
                "properties": {
                  "build_cost": { "type": "integer", "minimum": 1, "maximum": 5 },
                  "infrastructure_cost": { "type": "integer", "minimum": 1, "maximum": 5 },
                  "feedback_speed_value": { "type": "integer", "minimum": 1, "maximum": 5 },
                  "defect_prevention_value": { "type": "integer", "minimum": 1, "maximum": 5 },
                  "coverage_value": { "type": "integer", "minimum": 1, "maximum": 5 },
                  "reliability_confidence": { "type": "integer", "minimum": 1, "maximum": 5 }
                },
                "additionalProperties": false
              },
              "rationale": { "type": "string", "minLength": 1 },
              "reviewed_at": { "type": "string", "format": "date" },
              "retirement": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": { "enum": ["ACTIVE", "RETIRED"] },
                  "date": { "type": "string", "format": "date" },
                  "reason": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "network_interception": {
            "type": ["object", "null"],
            "required": ["mode", "routes", "implementation_file", "implementation_export"],
            "properties": {
              "mode": { "enum": ["MOCK", "HAR", "OBSERVE"] },
              "routes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["pattern", "action"],
                  "properties": {
                    "pattern": { "type": "string", "minLength": 1 },
                    "action": { "enum": ["FULFILL", "ABORT", "CONTINUE", "HAR"] },
                    "fixture_file": { "type": "string", "minLength": 1 },
                    "status": { "type": "integer", "minimum": 100, "maximum": 599 }
                  },
                  "allOf": [
                    {
                      "if": { "properties": { "action": { "const": "FULFILL" } }, "required": ["action"] },
                      "then": { "required": ["fixture_file", "status"] }
                    }
                  ],
                  "additionalProperties": true
                }
              },
              "real_flow_testcase_id": { "type": "string", "minLength": 1 },
              "service_workers": { "enum": ["block"] },
              "har_file": { "type": "string", "minLength": 1 },
              "sanitized": { "type": "boolean" },
              "allowed_hosts": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "implementation_file": { "type": "string", "minLength": 1 },
              "implementation_export": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" }
            },
            "allOf": [
              {
                "if": { "type": "object", "properties": { "mode": { "const": "HAR" } }, "required": ["mode"] },
                "then": { "required": ["har_file", "sanitized", "service_workers", "allowed_hosts", "real_flow_testcase_id"] }
              },
              {
                "if": { "type": "object", "properties": { "mode": { "const": "MOCK" } }, "required": ["mode"] },
                "then": { "required": ["real_flow_testcase_id"] }
              }
            ],
            "additionalProperties": false
          },
          "db_verification": {
            "type": ["object", "null"],
            "required": ["mode", "read_only", "implementation_file", "implementation_export"],
            "properties": {
              "mode": { "enum": ["INTERNAL_API", "DIRECT_SQL"] },
              "read_only": { "const": true },
              "scope": { "enum": ["RECORD", "CROSS_TABLE", "RECONCILIATION"] },
              "implementation_file": { "type": "string", "minLength": 1 },
              "implementation_export": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
              "operation_ref": { "type": "string", "minLength": 1 },
              "proof_kind": { "enum": ["PERSISTENCE_READ_MODEL"] },
              "driver": { "enum": ["pg", "mysql2", "knex"] },
              "credential_env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
              "query_file": { "type": "string", "minLength": 1 },
              "parameterized": { "type": "boolean" },
              "polling": {
                "type": "object",
                "required": ["timeout_ms", "intervals_ms"],
                "properties": {
                  "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 60000 },
                  "intervals_ms": {
                    "type": "array", "minItems": 1,
                    "items": { "type": "integer", "minimum": 50 }
                  }
                },
                "additionalProperties": false
              }
            },
            "allOf": [
              {
                "if": { "type": "object", "properties": { "mode": { "const": "DIRECT_SQL" } }, "required": ["mode"] },
                "then": { "required": ["driver", "credential_env", "query_file", "parameterized"] }
              },
              {
                "if": { "type": "object", "properties": { "mode": { "const": "INTERNAL_API" } }, "required": ["mode"] },
                "then": { "required": ["operation_ref", "proof_kind"] }
              }
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "implementationHook": {
      "type": "object",
      "required": ["implementation_file", "implementation_export"],
      "properties": {
        "implementation_file": { "type": "string", "pattern": "^src/shared/helpers/.+\\.(?:ts|js|mjs)$" },
        "implementation_export": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" }
      },
      "additionalProperties": false
    }
  }
}
