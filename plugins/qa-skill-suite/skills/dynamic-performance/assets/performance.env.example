# Copy this file to dynamic-testing/performance/.env before creating a run config.
# The .env file is ignored by Git. This template contains examples only.
#
# Interactive mode lets you review and override each value:
#   python3 scripts/performance_orchestrator.py wizard --env-file .env --output run-config.yaml
#
# Non-interactive mode generates from this file and fails if a required value is blank:
#   python3 scripts/performance_orchestrator.py wizard --env-file .env --non-interactive --output run-config.yaml
#
# Keep tokens, passwords, cookies and API keys out of this file and out of the
# generated YAML. Use placeholders such as ${TOKEN} in request headers/body and
# provide the real variable only in the process environment immediately before
# an approved engine run.

PERF_ENGINE=k6
PERF_TEST_TYPE=load
PERF_WORKLOAD_MODEL=concurrent-users

PERF_TARGET_BASE_URL=https://qa.example.com
PERF_TARGET_ENVIRONMENT=qa
PERF_TARGET_OWNER=replace-with-team-or-owner
PERF_AUTHORIZATION_REFERENCE=replace-with-approval-id

# concurrent-users
PERF_USERS=10
PERF_RAMP_UP=30s
PERF_HOLD_DURATION=2m
PERF_RAMP_DOWN=30s
PERF_THINK_TIME=1s

# request-rate (used when PERF_WORKLOAD_MODEL=request-rate)
PERF_TARGET_RATE=10
PERF_TIME_UNIT=1s
PERF_PRE_ALLOCATED_VUS=2
PERF_MAX_VUS=10

# total-iterations (used when PERF_WORKLOAD_MODEL=total-iterations)
PERF_ITERATIONS=100

# Optional CSV data contract
PERF_TEST_DATA_FILE=
PERF_TEST_DATA_VARIABLES=email,password
PERF_TEST_DATA_UNIQUE_PER_USER=true

# Shared quality gates
PERF_P95_MS=1000
PERF_P99_MS=2000
PERF_MAX_ERROR_RATE=0.01
PERF_MIN_REQUESTS_PER_SECOND=1
PERF_ABORT_ON_FAILURE=false

# Safety and observability
PERF_MAX_USERS=100
PERF_ABORT_CONDITIONS=error rate exceeds agreed limit,service health check fails
PERF_CLEANUP=no mutated test data
PERF_MONITORING=service dashboard
PERF_SCRIPT_PATH=

# Required only for testType=volume
PERF_DATASET_REFERENCE=PERF-DATA-100K
PERF_RECORDS=100000
PERF_PAYLOAD_SIZE_BYTES=2048
PERF_VOLUME_CLEANUP=remove the isolated tenant after the run
PERF_INTEGRITY_CHECK=compare record count and checksum with the seed manifest

# Required only for testType=scalability
PERF_COMPARISON_GROUP=checkout-capacity-v1
PERF_RESOURCE_PROFILE=baseline-2-replicas
PERF_RESOURCE_REFERENCE=2 application replicas and 4 vCPU
PERF_MIN_CAPACITY_USERS=100
PERF_MIN_CAPACITY_RPS=50
