{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-skill.local/schemas/testcase-execution-contract-v1.json",
  "title": "Testcase execution contract",
  "type": "object",
  "required": ["version", "entry", "steps", "outcome"],
  "properties": {
    "version": { "const": 1 },
    "mutates": { "type": "boolean" },
    "entry": {
      "type": "object",
      "properties": {
        "route": { "type": "string" },
        "role": { "type": "string" },
        "state": { "type": "string" },
        "permissions": { "type": ["array", "string"] },
        "data": { "type": ["object", "array", "string"] }
      },
      "additionalProperties": true
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "action", "instruction"],
        "properties": {
          "id": { "type": "string", "pattern": "^S[0-9]{2,}$" },
          "action": {
            "enum": ["navigate", "fill", "clear", "select", "check", "uncheck", "click", "press", "upload", "wait", "observe", "assert"]
          },
          "instruction": { "type": "string", "minLength": 1 },
          "target": {
            "type": "object",
            "required": ["key", "kind", "name"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "role": { "type": "string" },
              "label": { "type": "string" },
              "placeholder": { "type": "string" },
              "test_id": { "type": "string" },
              "id": { "type": "string" },
              "route": { "type": "string" },
              "selector_evidence": { "$ref": "#/$defs/selectorEvidence" }
            },
            "additionalProperties": true
          },
          "value": {},
          "wait_for": {
            "oneOf": [
              { "type": "string" },
              { "type": "object", "required": ["kind"], "additionalProperties": true }
            ]
          },
          "assertions": {
            "type": "array",
            "items": { "$ref": "#/$defs/assertion" }
          }
        },
        "additionalProperties": true
      }
    },
    "outcome": {
      "type": "object",
      "required": ["assertions"],
      "properties": {
        "state": { "type": "string" },
        "route": { "type": "string" },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assertion" }
        }
      },
      "additionalProperties": true
    },
    "cleanup": {}
  },
  "additionalProperties": true,
  "$defs": {
    "assertion": {
      "type": "object",
      "anyOf": [
        { "required": ["text"] },
        { "required": ["kind"] }
      ],
      "properties": {
        "kind": { "type": "string" },
        "target": { "type": "string" },
        "target_name": { "type": "string" },
        "value": {},
        "expected": {},
        "text": { "type": "string" }
      },
      "additionalProperties": true
    },
    "selectorEvidence": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["unresolved", "runtime_verified", "not_applicable"] },
        "strategy": { "type": "string" },
        "locator": { "type": "string" },
        "reason": { "type": "string" },
        "verification": {
          "type": "object",
          "properties": {
            "count": { "const": 1 },
            "visible": { "const": true },
            "actionable": { "type": "boolean" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
