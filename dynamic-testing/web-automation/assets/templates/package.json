{
  "name": "qa-automation",
  "version": "1.0.0",
  "description": "Playwright + TypeScript test automation với POM pattern",
  "private": true,
  "scripts": {
    "test": "npm run placeholder-check && npm run qa:lint && npm run qa:test -- --surface all",
    "test:ui": "node scripts/qa.mjs test --surface ui",
    "test:api": "node scripts/qa.mjs test --surface api",
    "test:functional": "node scripts/qa.mjs test --surface functional",
    "test:functional:parallel": "node scripts/qa.mjs test --surface functional",
    "test:perf": "node scripts/qa.mjs test -- --grep @perf",
    "test:smoke": "node scripts/qa.mjs test -- --grep @smoke",
    "test:regression": "node scripts/qa.mjs test -- --grep-invert @perf",
    "qa:lint": "node scripts/qa.mjs lint",
    "qa:test": "node scripts/qa.mjs test",
    "qa:test:ui": "node scripts/qa.mjs test --surface ui",
    "qa:test:api": "node scripts/qa.mjs test --surface api",
    "qa:test:functional": "node scripts/qa.mjs test --surface functional",
    "qa:contract": "node scripts/qa.mjs contract",
    "qa:report": "node scripts/qa.mjs report",
    "qa:quality": "node scripts/qa.mjs quality",
    "qa:preflight": "node scripts/ci-preflight.mjs",
    "qa:install:browsers": "node scripts/qa.mjs install-browsers",
    "qa:merge-allure": "node scripts/merge-allure-results.mjs",
    "qa:clean": "node scripts/qa.mjs clean",
    "qa:ci": "node scripts/qa.mjs ci",
    "quality-gate": "node scripts/quality-gate.mjs --config quality-gates.json --report reports/playwright.json",
    "quality-gate:config": "node -e \"const c=require('./quality-gates.json'); if(!c.version||!c.thresholds) process.exit(1); console.log('quality-gates.json PASS')\"",
    "traceability": "node scripts/verify-testcase-traceability.mjs",
    "ui-coverage": "node scripts/verify-ui-coverage.mjs",
    "discover:selectors": "node scripts/discover-runtime-selectors.mjs",
    "promote:evidence": "node scripts/promote-runtime-evidence.mjs",
    "runtime-scaffold": "node scripts/verify-runtime-scaffold.mjs",
    "pom-plan": "node scripts/generate-pom-plan.mjs",
    "module-layout": "node scripts/verify-module-artifact-layout.mjs",
    "testcase-workflow": "node scripts/run-testcase-pom.mjs",
    "bootstrap:runtime": "node scripts/bootstrap-playwright.mjs --project-root . --browsers chromium",
    "check:types": "tsc --noEmit",

    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:ui-mode": "playwright test --ui",

    "test:report": "node scripts/qa.mjs html",
    "allure:contract": "node scripts/qa.mjs contract",
    "allure:gen": "node scripts/qa.mjs report",
    "allure:open": "node scripts/qa.mjs open-allure",
    "allure:serve": "node scripts/qa.mjs serve-allure",

    "placeholder-check": "node scripts/check-placeholders.mjs",
    "lint": "node scripts/qa.mjs lint",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",

    "install:browsers": "node scripts/qa.mjs install-browsers --browser chromium,firefox,webkit",
    "bootstrap": "node scripts/bootstrap.mjs",
    "clean": "node scripts/qa.mjs clean",
    "cleanup:sessions": "node -e \"require('./fixtures/session').cleanupOldSessions(7)\"",
    "pretest": "npm run bootstrap:runtime -- --skip-types",
    "pretest:ui": "npm run bootstrap:runtime -- --skip-types",
    "pretest:api": "npm run bootstrap:runtime -- --skip-types",
    "pretest:functional": "npm run bootstrap:runtime",
    "pretest:functional:parallel": "npm run bootstrap:runtime",
    "pretest:perf": "npm run bootstrap:runtime -- --skip-types",
    "pretest:smoke": "npm run bootstrap:runtime -- --skip-types",
    "pretest:regression": "npm run bootstrap:runtime -- --skip-types",
    "prelint": "npm run bootstrap:runtime -- --skip-types",
    "precheck:types": "npm run bootstrap:runtime -- --skip-types"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.45.0",
    "@types/node": "^24.0.0",
    "allure-commandline": "^2.27.0",
    "allure-playwright": "^2.15.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "prettier": "^3.3.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0",
    "zod": "^3.23.0"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0",
    "npm": ">=9.0.0"
  }
}
