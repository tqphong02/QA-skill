# Environment Variables — copy thành .env (gitignored)
# ============================================================
# Tất cả biến được đọc qua fixtures/env.ts.
# Nếu thiếu biến REQUIRED → fail fast khi load.
#
# Setup:
#   1. Copy:  cp .env.example .env
#   2. Fill:  sửa giá trị theo project
#   3. .env đã có trong .gitignore — KHÔNG commit

# ─────────────────────────────────────────────────────────────
# API (REQUIRED)
# ─────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:3000
API_TIMEOUT_MS=30000

# ─────────────────────────────────────────────────────────────
# UI / E2E (REQUIRED cho UI test)
# ─────────────────────────────────────────────────────────────
UI_BASE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Auth credentials (REQUIRED)
# ─────────────────────────────────────────────────────────────
TEST_USER=<ADMIN_TEST_COM>
TEST_PASS=<ADMIN_123>

# Parallel tests thay đổi account-owned state:
# account và dataset unique phải >= PW_WORKERS; fixture chọn pool[parallelIndex]
# TEST_ACCOUNTS_JSON=[{"email":"qa-slot-0@test.com","password":"Secret0"},{"email":"qa-slot-1@test.com","password":"Secret1"}]
# TEST_DATASETS_JSON=[{"id":"data-0","dataRoot":"runtime-data/slot-0","values":{"tenant":"tenant-0"}},{"id":"data-1","dataRoot":"runtime-data/slot-1","values":{"tenant":"tenant-1"}}]
# QA_PROJECT_KEY=MY_PROJECT              # ưu tiên MY_PROJECT_TEST_*_JSON nếu được set
# PW_WORKERS=2

# Nếu có multi-tenant (vd: OneBrain) — thêm tenant identifier
# TENANT_ID=tenant-001
# TENANT_NAME=Test Tenant

# ─────────────────────────────────────────────────────────────
# Feature flags (OPTIONAL)
# ─────────────────────────────────────────────────────────────
# CI=true                           # Auto-detect trên CI runner
# DEBUG=false                       # Bật debug logging
# HEADLESS=true                     # Browser headless mode

# ─────────────────────────────────────────────────────────────
# Allure (OPTIONAL)
# ─────────────────────────────────────────────────────────────
# ALLURE_RESULTS_DIR=reports/allure-results

# ─────────────────────────────────────────────────────────────
# k6 / Performance (OPTIONAL — Tier 2)
# ─────────────────────────────────────────────────────────────
# K6_BASE_URL=https://staging.example.com
# K6_VUS=50
# K6_DURATION=1m

# ─────────────────────────────────────────────────────────────
# CI/CD secrets (set trong Jenkins/GitHub Actions, KHÔNG cần trong .env local)
# ─────────────────────────────────────────────────────────────
# CI_API_BASE_URL=https://api.staging.example.com
# CI_TEST_USER=ci-bot@example.com
# CI_TEST_PASS=<random-secret>
