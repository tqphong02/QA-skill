pipeline {
  agent any
  options {
    timeout(time: 60, unit: 'MINUTES')
  }
  parameters {
    string(name: 'PERFORMANCE_CONFIG', defaultValue: 'run-config.yaml')
    booleanParam(name: 'APPROVE_LOAD', defaultValue: false)
  }
  stages {
    stage('Validate and prepare') {
      steps {
        sh '''
          python3 dynamic-testing/performance/scripts/performance_orchestrator.py validate --config "$PERFORMANCE_CONFIG"
          python3 dynamic-testing/performance/scripts/performance_orchestrator.py prepare \
            --config "$PERFORMANCE_CONFIG" \
            --project-root . \
            --output-root artifacts > prepare.json
        '''
      }
    }
    stage('Approved smoke and load') {
      when {
        expression { params.APPROVE_LOAD }
      }
      steps {
        sh '''
          RUN_DIR=$(python3 -c "import json; print(json.load(open('prepare.json'))['runDir'])")
          python3 dynamic-testing/performance/scripts/performance_orchestrator.py run \
            --run-dir "$RUN_DIR" \
            --approve-load
        '''
      }
    }
  }
  post {
    always {
      archiveArtifacts artifacts: 'artifacts/**/*', allowEmptyArchive: true
    }
  }
}
