{
  "name": "qa-skill",
  "version": "1.0.0",
  "description": "QA-skill — bộ 23 skill QE/Security/MCP cho Codex, Claude, Gemini, Cursor, Windsurf, Copilot",
  "main": "index.js",
  "scripts": {
    "test": "node scripts/test-suite.mjs",
    "test:skills": "node scripts/skill-readiness-suite.mjs",
    "test:skills:strict-live": "node scripts/skill-readiness-suite.mjs --strict-live",
    "test:routing": "node scripts/benchmark-core-routing.mjs",
    "test:routing:certify": "node scripts/benchmark-core-routing.mjs --certification --output evidence/ai-eval/core-routing-certification-latest.json",
    "security:detect": "node dynamic-testing/security-pentest/skills/pentest-security/scripts/detect.mjs",
    "security:preflight": "node dynamic-testing/security-pentest/skills/pentest-security/scripts/preflight.mjs",
    "security:scan": "node dynamic-testing/security-pentest/skills/pentest-security/scripts/run-scan.mjs",
    "security:normalize": "node dynamic-testing/security-pentest/skills/pentest-security/scripts/normalize-findings.mjs",
    "security:testcases": "node dynamic-testing/security-pentest/skills/pentest-security/scripts/generate-security-tests.mjs",
    "security:ai-scan": "node dynamic-testing/security-pentest/skills/pentest-security/scripts/ai-scan.mjs",
    "security:ai-scan:gemini": "node dynamic-testing/security-pentest/skills/pentest-security/scripts/ai-scan.mjs --engine gemini",
    "security:ai-scan:claude": "node dynamic-testing/security-pentest/skills/pentest-security/scripts/ai-scan.mjs --engine claude",
    "security:antigravity-host": "node dynamic-testing/security-pentest/skills/pentest-security/scripts/antigravity-host-scan.mjs",
    "test:pentest-security": "node --test dynamic-testing/security-pentest/skills/pentest-security/tests/*.spec.mjs",
    "security:login": "node dynamic-testing/security-pentest/skills/pentest-security/scripts/engine-login.mjs",
    "security:login:claude": "node dynamic-testing/security-pentest/skills/pentest-security/scripts/engine-login.mjs claude",
    "security:login:gemini": "node dynamic-testing/security-pentest/skills/pentest-security/scripts/engine-login.mjs gemini",
    "security:login:status": "node dynamic-testing/security-pentest/skills/pentest-security/scripts/engine-login.mjs status",
    "catalog:effective-html": "node scripts/build-effective-skill-html.mjs"
  },
  "repository": {
    "type": "git",
